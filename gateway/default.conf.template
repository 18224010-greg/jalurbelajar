# ${API_KEY} diisi otomatis dari environment container saat start (envsubst).
map $http_x_api_key $api_key_valid {
    default 0;
    "${API_KEY}" 1;
}

server {
    listen 80;
    server_tokens off;
    default_type application/json;

    # Tanpa API key: cek hidup + dokumentasi
    location = /api/health {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://core:8000;
    }
    location ~ ^/api/(docs|openapi\.json)$ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://core:8000;
    }

    # Semua endpoint lain wajib X-API-Key
    location /api/ {
        if ($api_key_valid = 0) {
            return 401 '{"detail":"API key tidak valid atau tidak ada"}';
        }
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://core:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 404 '{"detail":"Tidak ditemukan. Gunakan /api/..."}';
    }
}
