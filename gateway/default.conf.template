# ${API_KEY} diisi otomatis dari environment container saat start (envsubst).
# Gateway menandai permintaan yang membawa X-API-Key valid dengan header X-Gateway-Auth: key.
# Header itu SELALU ditimpa di sini (kosong bila key salah), jadi klien tidak bisa memalsukannya.
# Pemeriksaan akhir (API key atau token login) dilakukan service core.
map $http_x_api_key $gateway_auth {
    default "";
    "${API_KEY}" "key";
}

server {
    listen 80;
    server_tokens off;
    default_type application/json;
    client_max_body_size 1m;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://core:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Gateway-Auth $gateway_auth;
    }

    location / {
        return 404 '{"detail":"Tidak ditemukan. Gunakan /api/..."}';
    }
}
